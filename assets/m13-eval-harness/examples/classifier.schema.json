{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": ["category", "urgency", "suggested_action", "confidence", "reasoning"],
  "properties": {
    "category": {
      "type": "string",
      "enum": [
        "billing",
        "bug",
        "feature_request",
        "feedback",
        "account",
        "outage",
        "technical",
        "other"
      ]
    },
    "urgency": {
      "type": "string",
      "enum": ["low", "medium", "high", "critical"]
    },
    "suggested_action": {
      "type": "string",
      "enum": ["auto_reply", "route_to_billing", "route_to_engineering", "escalate", "human_review"]
    },
    "confidence": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "reasoning": {
      "type": "string",
      "maxLength": 200
    }
  },
  "additionalProperties": false
}
