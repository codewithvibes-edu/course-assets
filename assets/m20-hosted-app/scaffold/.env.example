# Copy to .env (gitignored). Defaults point at the Module 19 lab service,
# which is free and local. A real provider goes here later via a dated
# recipe, and only ever here: values in the environment, never in code.
MODEL_BASE_URL=http://127.0.0.1:8124
MODEL_API_KEY=mock-key-local-only
MODEL_NAME=mock-1

# The application's own budgets. These are contract numbers, not vibes:
# change them in application_contract.md first, then here.
APP_TIMEOUT_S=15
APP_MAX_TURNS=6
APP_MAX_INPUT_CHARS=20000
